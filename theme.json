{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary", "name": "Blu Betnero", "color": "#036AA9" },
				{ "slug": "accent", "name": "Blu chiaro", "color": "#0380CC" },
				{ "slug": "orange", "name": "Arancio", "color": "#EEA700" },
				{ "slug": "green", "name": "Verde", "color": "#389C04" },
				{ "slug": "ink", "name": "Titoli", "color": "#1D2433" },
				{ "slug": "text", "name": "Testo", "color": "#333333" },
				{ "slug": "muted", "name": "Testo secondario", "color": "#5D6676" },
				{ "slug": "line", "name": "Bordi", "color": "#E6E9EF" },
				{ "slug": "surface", "name": "Sfondo chiaro", "color": "#F4F6F9" },
				{ "slug": "footer", "name": "Sfondo footer", "color": "#F0ECEC" },
				{ "slug": "white", "name": "Bianco", "color": "#FFFFFF" }
			],
			"gradients": [
				{ "slug": "hero", "name": "Hero blu", "gradient": "linear-gradient(135deg,#036AA9 0%,#0380CC 100%)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{ "slug": "sen", "name": "Sen", "fontFamily": "Sen, system-ui, -apple-system, 'Segoe UI', sans-serif" }
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "XS", "size": "12px", "fluid": false },
				{ "slug": "small", "name": "S", "size": "14px", "fluid": false },
				{ "slug": "medium", "name": "M", "size": "16px", "fluid": false },
				{ "slug": "large", "name": "L", "size": "20px", "fluid": { "min": "18px", "max": "20px" } },
				{ "slug": "x-large", "name": "XL", "size": "26px", "fluid": { "min": "22px", "max": "26px" } },
				{ "slug": "xx-large", "name": "XXL", "size": "34px", "fluid": { "min": "26px", "max": "34px" } }
			]
		},
		"spacing": {
			"units": [ "px", "%", "em", "rem", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "6px" },
				{ "slug": "20", "name": "2", "size": "12px" },
				{ "slug": "30", "name": "3", "size": "18px" },
				{ "slug": "40", "name": "4", "size": "24px" },
				{ "slug": "50", "name": "5", "size": "36px" },
				{ "slug": "60", "name": "6", "size": "56px" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sen)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "18px",
			"padding": { "left": "16px", "right": "16px" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.25" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--white)" },
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--small)" },
				"spacing": { "padding": { "top": "10px", "bottom": "10px", "left": "20px", "right": "20px" } },
				":hover": { "color": { "background": "var(--wp--preset--color--accent)" } }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "sidebar", "title": "Sidebar articoli", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-full", "title": "Pagina a tutta larghezza", "postTypes": [ "page" ] }
	]
}
